<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/rareGeneticDiseases/ontology#"
     xml:base="http://www.semanticweb.org/rareGeneticDiseases/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology">
        <rdfs:comment>Rare monogenic / inborn-error-of-metabolism ontology for LLM+ontology evaluation research. Fifty diseases with gene, enzyme, metabolite, symptom, organ system, treatment and inheritance-pattern relations. NOTE: gene/enzyme/metabolite/symptom/treatment/inheritance associations reflect standard medical genetics knowledge; verify exact identifiers (OMIM/ORPHA codes) against Orphanet/OMIM before publication.</rdfs:comment>
    </owl:Ontology>

    <!-- ============ CLASSES ============ -->
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity">
        <rdfs:label>Biological Entity</rdfs:label>
        <rdfs:comment>Root class for all domain entities in this ontology.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Disease</rdfs:label>
        <rdfs:comment>A rare monogenic disease. Anchor class linking genes, enzymes, metabolites, symptoms and treatments.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#AminoAcidMetabolismDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Amino Acid Metabolism Disorder</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as amino acid metabolism disorders.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganicAcidemia">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Organic Acidemia</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as organic acidemias.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#UreaCycleDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Urea Cycle Disorder</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as urea cycle disorders.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#FattyAcidOxidationDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Fatty Acid Oxidation Disorder</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as fatty acid oxidation disorders.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#LysosomalStorageDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Lysosomal Storage Disorder</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as lysosomal storage disorders.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#GlycogenStorageDisease">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Glycogen Storage Disease</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as glycogen storage diseases.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#PeroxisomalDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Peroxisomal Disorder</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as peroxisomal disorders.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#OtherMonogenicDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Other Monogenic Disorder</rdfs:label>
        <rdfs:comment>Diseases classified biochemically as other monogenic disorders.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Gene">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Gene</rdfs:label>
        <rdfs:comment>A gene whose defect causes a disease.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Protein">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Protein</rdfs:label>
        <rdfs:comment>A protein product of a gene.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Enzyme">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Protein"/>
        <rdfs:label>Enzyme</rdfs:label>
        <rdfs:comment>A catalytic protein; the functional consequence of a causative gene defect.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Metabolite">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Metabolite</rdfs:label>
        <rdfs:comment>A small-molecule substrate or product that accumulates or is deficient in a disease.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Phenotype">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Phenotype</rdfs:label>
        <rdfs:comment>A clinical symptom or finding associated with a disease.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Organ System</rdfs:label>
        <rdfs:comment>A coarse anatomical/physiological grouping that a phenotype affects.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Treatment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Treatment</rdfs:label>
        <rdfs:comment>A management or therapeutic intervention for a disease.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Cofactor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Cofactor</rdfs:label>
        <rdfs:comment>A vitamin or small molecule required for enzyme function.</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#InheritancePattern">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#BiologicalEntity"/>
        <rdfs:label>Inheritance Pattern</rdfs:label>
        <rdfs:comment>Mode of genetic inheritance (closed set of individuals).</rdfs:comment>
    </owl:Class>
    <owl:Class rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#CofactorResponsiveDisorder">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:label>Cofactor-Responsive Disorder</rdfs:label>
        <rdfs:comment>Defined class: a disease whose deficient enzyme requires a cofactor. Membership should be inferred by the reasoner (HermiT/Pellet), not asserted directly, once the equivalentClass restriction below is added in Protege via the class expression editor: Disease and (hasDeficientEnzyme some (Enzyme and (requiresCofactor some Cofactor))).</rdfs:comment>
    </owl:Class>

    <!-- ============ OBJECT PROPERTIES ============ -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasCausativeGene">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Gene"/>
        <rdfs:label>has causative gene</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#causesDisease">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Gene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasCausativeGene"/>
        <rdfs:label>causes disease</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#encodes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Gene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Protein"/>
        <rdfs:label>encodes</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#encodedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Protein"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Gene"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#encodes"/>
        <rdfs:label>encoded by</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasDeficientEnzyme">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Enzyme"/>
        <rdfs:label>has deficient enzyme</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#isDeficientEnzymeOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Enzyme"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasDeficientEnzyme"/>
        <rdfs:label>is deficient enzyme of</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#accumulatesMetabolite">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Metabolite"/>
        <rdfs:label>accumulates metabolite</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#isAccumulatedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Metabolite"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#accumulatesMetabolite"/>
        <rdfs:label>is accumulated in</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasSymptom">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Phenotype"/>
        <rdfs:label>has symptom</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#isSymptomOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Phenotype"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasSymptom"/>
        <rdfs:label>is symptom of</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#affectsOrganSystem">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Phenotype"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>affects organ system</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#treatedWith">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Treatment"/>
        <rdfs:label>treated with</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#isTreatmentFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Treatment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#treatedWith"/>
        <rdfs:label>is treatment for</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasInheritancePattern">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#InheritancePattern"/>
        <rdfs:label>has inheritance pattern</rdfs:label>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#requiresCofactor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Enzyme"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Cofactor"/>
        <rdfs:label>requires cofactor</rdfs:label>
    </owl:ObjectProperty>

    <!-- ============ DATA PROPERTIES ============ -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#geneSymbol">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Gene"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>gene symbol</rdfs:label>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasOMIMId">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has OMIM ID</rdfs:label>
        <rdfs:comment>Not populated in this file — look up and fill in from omim.org before publication.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#hasOrphaCode">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Disease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>has Orphanet code</rdfs:label>
        <rdfs:comment>Not populated in this file — look up and fill in from orpha.net before publication.</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ============ INDIVIDUALS: Inheritance Patterns ============ -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#AutosomalRecessive">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#InheritancePattern"/>
        <rdfs:label>Autosomal Recessive</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#AutosomalDominant">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#InheritancePattern"/>
        <rdfs:label>Autosomal Dominant</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#XLinked">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#InheritancePattern"/>
        <rdfs:label>X-Linked</rdfs:label>
    </owl:NamedIndividual>

    <!-- ============ INDIVIDUALS: Organ Systems ============ -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Cardiovascular">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Cardiovascular System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Dermatologic">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Dermatologic System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Endocrine">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Endocrine System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#GastrointestinalSystem">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Gastrointestinal System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Hepatic">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Hepatic System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Metabolic">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Metabolic System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Muscular">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Muscular System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#NervousSystem">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Nervous System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Ocular">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Ocular System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Renal">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Renal System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Respiratory">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Respiratory System</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Skeletal">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#OrganSystem"/>
        <rdfs:label>Skeletal System</rdfs:label>
    </owl:NamedIndividual>

    <!-- ============ INDIVIDUALS: Cofactors ============ -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#Biotin">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Cofactor"/>
        <rdfs:label>Biotin</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#VitaminB12">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Cofactor"/>
        <rdfs:label>Vitamin B12</rdfs:label>
    </owl:NamedIndividual>

    <!-- ============ INDIVIDUALS: Treatments ============ -->
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#AllopurinolTherapy">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Treatment"/>
        <rdfs:label>Allopurinol Therapy</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#ArginineSupplementation">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Treatment"/>
        <rdfs:label>Arginine Supplementation</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#AvoidanceOfFasting">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Treatment"/>
        <rdfs:label>Avoidance of Fasting</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/rareGeneticDiseases/ontology#AvoidanceOfStrenuousExercise">
        <rdf:type rdf:resource="http://www.semanticweb.org/rareGeneticDiseases/ontology#Treatment"/>
